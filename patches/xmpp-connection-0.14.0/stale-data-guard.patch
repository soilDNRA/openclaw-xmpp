   _onData(data) {
+    // OPENCLAW PATCH (2026-10-19): guard against socket "data" arriving after
+    // parser detach (stream error, stop, or see-other-host). Fixes uncaught
+    // TypeError "Cannot read properties of null (reading 'write')" which
